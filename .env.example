# Public base URL of the deployment (used for canonical + OpenGraph URLs)
VITE_SITE_URL=https://petverse.lovable.app

# Base URL for API endpoints (defaults to same-origin /api)
VITE_API_BASE_URL=/api

# Analytics collection endpoint (leave empty to disable network sends)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_SITE_ID=petverse
